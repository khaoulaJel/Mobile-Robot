<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="CC_robot">
<xacro:arg name="device" default="/dev/ttyACM0"/>
<xacro:include filename="$(find cc_robot_urdf)/urdf/CC_robot_URDF.urdf"/>
<ros2_control name="RealRobot" type="system"><hardware>
<plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
<param name="left_wheel_name">left_wheel_joint</param><param name="right_wheel_name">right_wheel_joint</param>
<param name="loop_rate">30</param><param name="device">$(arg device)</param><param name="baud_rate">57600</param><param name="timeout_ms">50</param><param name="enc_counts_per_rev">1980</param>
</hardware>
<xacro:macro name="wheel" params="name"><joint name="${name}"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint></xacro:macro>
<xacro:wheel name="left_wheel_joint"/><xacro:wheel name="right_wheel_joint"/>
</ros2_control></robot>