<?xml version="1.0"?>
<robot name="cc_robot_lab3">
  <!-- Simulation-only adaptation of CC_robot_URDF.urdf. See ../SIMULATION.md. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/base_link.STL" />
      </geometry>
      <material name="base_link_material_0">
        <color rgba="0.109803921568627 0.109803921568627 0.109803921568627 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="base_footprint">
    </link>
  <joint name="footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_footprint" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="chassis_Link">
    </link>
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0 0 0.04975" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis_Link" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="right_wheel">
    <inertial>
      <origin xyz="-1.15490513680205E-09 -1.44586093098198E-09 0.000987222349883771" rpy="0 0 0" />
      <mass value="0.0351748325392023" />
      <inertia ixx="1.52373114694877E-05" ixy="-4.63299332368418E-10" ixz="-1.0852086805609E-13" iyy="1.52369513373906E-05" iyz="-1.78678964045005E-13" izz="2.57858862121828E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/right_wheel.STL" />
      </geometry>
      <material name="right_wheel_material_0">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision name="right_wheel_collision">
      <origin xyz="0 0 -0.00134786777" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.031750001" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.088523 0" rpy="1.5707963267948966 0 0" />
    <parent link="base_link" />
    <child link="right_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="1.0" velocity="30.0" />
    <dynamics damping="0.001" friction="0.0" />
  </joint>
  <link name="left_wheel">
    <inertial>
      <origin xyz="2.7837E-10 6.465E-10 0.00098722" rpy="0 0 0" />
      <mass value="0.035175" />
      <inertia ixx="1.5238E-05" ixy="-1.0416E-10" ixz="2.5748E-14" iyy="1.5237E-05" iyz="6.4118E-14" izz="2.5786E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/left_wheel.STL" />
      </geometry>
      <material name="left_wheel_material_0">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision name="left_wheel_collision">
      <origin xyz="0 0 -0.00134786777" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.031750001" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.088523 0" rpy="-1.5707963267948966 0 0" />
    <parent link="base_link" />
    <child link="left_wheel" />
    <axis xyz="0 0 1" />
    <limit effort="1.0" velocity="30.0" />
    <dynamics damping="0.001" friction="0.0" />
  </joint>
  <link name="caster_wheel">
    <visual name="caster_wheel_visual">
      <geometry>
        <sphere radius="0.023" />
      </geometry>
      <material name="caster_support_material">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>
    <collision name="caster_wheel_collision">
      <geometry>
        <sphere radius="0.023" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02" />
      <inertia ixx="0.000004232" iyy="0.000004232" izz="0.000004232" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <origin xyz="0.11932 0 -0.011" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="caster_wheel" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="base_laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/base_laser.STL" />
      </geometry>
      <material name="base_laser_material_0">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cc_robot_urdf/meshes/base_laser.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="base_laser_joint" type="fixed">
    <origin xyz="0 0 0.18975" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_laser" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="base_inertia">
    <inertial>
      <origin xyz="0.0248182433470027 0.000181965976845652 0.0650321143776021" rpy="0 0 0" />
      <mass value="1.76637995132488" />
      <inertia ixx="0.0058535479267807" ixy="-3.84230028262064E-05" ixz="0.000610541961536564" iyy="0.00592952154427544" iyz="5.14415071388837E-06" izz="0.00895303557663574" />
    </inertial>
  </link>
  <joint name="base_inertia_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_inertia" />
  </joint>
  <link name="imu" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/diff_cont/cmd_vel_unstamped</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.177046</wheel_separation>
      <wheel_diameter>0.068</wheel_diameter>
      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <odometry_source>1</odometry_source>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
    <plugin name="wheel_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=/joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="caster_wheel_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
</robot>
